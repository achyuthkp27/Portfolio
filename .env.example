# "Ask AI" chat assistant. Copy to .env.local for local development (it is git-ignored).

# Server only: the Google Gemini API key, from https://aistudio.google.com/app/apikey (free tier).
# Read by api/chat.ts; never sent to the browser. On Vercel, set it under Project > Settings >
# Environment Variables.
GOOGLE_GENERATIVE_AI_API_KEY=

# Server only, optional: a different Gemini model (default: gemini-3.5-flash-lite, free tier and
# about a second to start), the free-tier models tried in turn when it is busy, and how long (ms)
# each may take to start answering.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=8000

# Server only: abuse limits (the defaults shown). Per visitor, per function instance.
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_MAX_OUTPUT_TOKENS=500

# Server only: extra sites allowed to call the chat API, comma-separated. The site's own host and
# localhost are always allowed. On Vercel, set this to your GitHub Pages origin.
# CHAT_ALLOWED_ORIGINS=https://your-username.github.io

# Browser: where the site sends chat requests. Leave empty in dev and when the site itself runs on
# Vercel (both use /api/chat). For GitHub Pages, set the Vercel Function's full URL as a
# repository variable named VITE_CHAT_API_URL (see .github/workflows/deploy.yml).
# VITE_CHAT_API_URL=https://your-project.vercel.app/api/chat
